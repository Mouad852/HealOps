GEMINI_API_KEY=replace_with_your_gemini_key
EMAIL_USER=sender@gmail.com
EMAIL_APP_PASSWORD=replace_with_google_app_password
ALERT_EMAIL_TO=recipient@example.com
PROMETHEUS_BASE_URL=http://prometheus:9090
LOKI_BASE_URL=http://loki:3100
JAEGER_QUERY_URL=http://jaeger:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
POSTGRES_DB=healops
POSTGRES_USER=healops
POSTGRES_PASSWORD=replace_with_a_long_local_development_password
# Set SPRING_PROFILES_ACTIVE=demo when starting with `docker compose --profile demo up -d --build`
SPRING_PROFILES_ACTIVE=
HEALOPS_OPERATOR_USER=operator
HEALOPS_OPERATOR_PASSWORD=operator-local-dev
HEALOPS_VIEWER_USER=viewer
HEALOPS_VIEWER_PASSWORD=viewer-local-dev
